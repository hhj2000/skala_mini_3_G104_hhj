# LangSmith 추적 설정 — 실제 값은 .env에 넣는다 (.env는 git에 커밋하지 않음)
# Kharakteres 실행 스크립트가 LANGCHAIN_PROJECT 기본값을 정합니다.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=kharakteres-openai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# OpenAI 텍스트 생성 또는 STT/TTS 사용 시 필요 — 실제 OpenAI 계정에 과금되는
# 원격 API 키다. 절대 커밋하지 말고, 본인 계정의 유효한 키를 .env에만 넣을 것.
OPENAI_API_KEY=sk-...
# 기본값: fast=gpt-4o-mini, quality=gpt-4o (원하면 아래로 재정의)
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o

# Improvement switches (defaults shown)
AGENT_MODE=improved
# DEBUG_PROMPTS=1

# Interactive runtime / startup diagnostics (baseline keeps original adapters)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_THINK=false
OLLAMA_NUM_PREDICT=768
LLM_TIMEOUT_SECONDS=90
STARTUP_TIMEOUT_SECONDS=30
AUTO_START_OLLAMA=1
LOG_LEVEL=info

# Kharakteres (default service)
SERVICE_MODE=spells
SPELL_MAX_TOKENS=1536
SPELL_GENERATION_TIMEOUT_SECONDS=120
# Optional; relative paths are resolved from the project directory.
# SPELL_DB_PATH=data/kharakteres.sqlite

# AIDubsar-derived voice features (independent of the text-generation backend)
# Natural runtime default is OpenAI audio; fake runtime disables audio.
# SPEECH_BACKEND=disabled
SPEECH_STT_MODEL=whisper-1
SPEECH_TTS_MODEL=gpt-4o-mini-tts

# Shared content policy. Real runtimes default to model; fake defaults to rules.
# CONTENT_FILTER_MODE=model
# SPELL_VECTOR_ENABLED=1
SPELL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPELL_RAG_MIN_SCORE=0.25
SPELL_RETRIEVAL_TIMEOUT_SECONDS=25
