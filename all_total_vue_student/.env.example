# LangSmith 추적 설정 — 실제 값은 .env에 넣는다 (.env는 git에 커밋하지 않음)
# Kharakteres 실행 스크립트가 LANGCHAIN_PROJECT 기본값을 정합니다.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=kharakteres-openai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# OpenAI 텍스트 생성 또는 STT/TTS 사용 시 필요 — 실제 OpenAI 계정에 과금되는
# 원격 API 키다. 절대 커밋하지 말고, 본인 계정의 유효한 키를 .env에만 넣을 것.
OPENAI_API_KEY=sk-...
# 기본값: fast=gpt-4o-mini, quality=gpt-4o (원하면 아래로 재정의)
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o

# Improvement switches (defaults shown)
AGENT_MODE=improved
# DEBUG_PROMPTS=1

# Interactive runtime / startup diagnostics (baseline keeps original adapters)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_THINK=false
OLLAMA_NUM_PREDICT=768
LLM_TIMEOUT_SECONDS=90
STARTUP_TIMEOUT_SECONDS=30
AUTO_START_OLLAMA=1
LOG_LEVEL=info

# Local/Docker: one active login per account; successful new login replaces the old one.
# Login survives restart; keep the same DB/volume and signing key. Secret content does not persist.
# Docker Compose requires a session signing key.
# Generate it with: openssl rand -hex 32
# KHARAKTERES_SESSION_SECRET=replace-with-a-random-64-character-hex-key
# Enable only behind HTTPS: KHARAKTERES_COOKIE_SECURE=1

# Kharakteres (default service)
SERVICE_MODE=spells
SPELL_MAX_TOKENS=1536
SPELL_GENERATION_TIMEOUT_SECONDS=120
# Optional; relative paths are resolved from the project directory.
# SPELL_DB_PATH=data/kharakteres.sqlite

# AIDubsar-derived voice features (independent of the text-generation backend)
# Natural runtime default is OpenAI audio; fake runtime disables audio.
# SPEECH_BACKEND=disabled
SPEECH_STT_MODEL=whisper-1
SPEECH_TTS_MODEL=gpt-4o-mini-tts

# Shared content policy. Real runtimes default to model; fake defaults to rules.
# CONTENT_FILTER_MODE=model
# SPELL_VECTOR_ENABLED=1
SPELL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPELL_RAG_MIN_SCORE=0.25
SPELL_RETRIEVAL_TIMEOUT_SECONDS=25

# Web lexical evidence: local and Docker default wiktapi; plain docker compose up --build -d suffices.
# Explicit shell/.env overrides still win; wiktionary direct mode is optional.
# WiktAPI serves independently published Kaikki/Wiktextract dump data, not live revisions.
# SPELL_DICTIONARY_PROVIDER=wiktapi

# Korean-named language membership is bundled and fixed (modern/classical/extinct).
# Manual refresh only updates dictionary availability in this non-user-data cache.
# SPELL_LANGUAGE_CATALOG_CACHE=data/language_catalog.json

# Public HTTPS sharing with host-installed ngrok (not bundled into this app image).
# Guide: doc/NGROK_SHARING.md ; image/pull/push/update: doc/DOCKER_HUB.md
# Source localhost/Compose: run ngrok http 8100 on the same computer.
# Hub image joonsdocker/kharakteres:latest example maps host 8101 -> container 8100:
# run ngrok http 8101. The URL is the HTTPS Forwarding value printed by ngrok.
# Authenticate ngrok on the HOST with ngrok config add-authtoken "YOUR_NGROK_TOKEN".
# Do not put that token, a live public URL, personal DBs or real API keys in the image.
# Uncomment for HTTPS sharing; HTTP-only local development keeps the default 0.
# KHARAKTERES_COOKIE_SECURE=1
# Keep KHARAKTERES_SESSION_SECRET and data volumes stable across image replacement.
# Optional source-Compose host port (does not change the internal container port 8100):
# DOCKER_PORT=8100
# Hub/direct image runs need an explicit text backend; Compose already defaults openai:
# LLM_BACKEND=openai
# Editing this template does not modify your existing .env or a running container.
# Recreate containers after runtime env changes. Hub docs/image updates require rebuild/push;
# ngrok's token, URL and process remain outside the image.
